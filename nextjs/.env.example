# Next.js app runtime (frontend + API routes)

# Backend / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Public chain config
NEXT_PUBLIC_NETWORK=local
NEXT_PUBLIC_CHAIN_ID=43112
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_BLOCK_EXPLORER_URL=
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_AUCTION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_COMMISSION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ESCROW_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_AVAX_USD_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Smart Accounts (Mochi Passport) — get a free project at https://dashboard.zerodev.app
# Leave blank to disable the passkey login option.
NEXT_PUBLIC_ZERODEV_PROJECT_ID=
# Optional: override WebAuthn RP ID. Defaults to the current hostname in browser.
NEXT_PUBLIC_PASSKEY_RP_ID=
NEXT_PUBLIC_SIWE_DOMAIN=localhost
NEXT_PUBLIC_BASE_URL=http://localhost:3000

